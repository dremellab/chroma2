HOST_PEAKS = []
if HOST != "":
    HOST_PEAKS.extend(
        expand(join(RESULTSDIR, "{sample}", "peaks", "{sample}.host.macs2_peaks.narrowPeak"), sample=CASE_SAMPLES)
    )
    HOST_PEAKS.extend(
        expand(join(RESULTSDIR, "{sample}", "peaks", "{sample}.host.macs2_summits.bed"), sample=CASE_SAMPLES)
    )
    HOST_PEAKS.extend(
        expand(join(RESULTSDIR, "{sample}", "peaks", "{sample}.host.macs2_peaks.xls"), sample=CASE_SAMPLES)
    )
    HOST_PEAKS.extend(
        expand(join(RESULTSDIR, "{sample}", "peaks", "{sample}.host.genrich.narrowPeak"), sample=CASE_SAMPLES)
    )

VIRUS_PEAKS = []
if len(VIRUS_LIST) > 0:
    VIRUS_PEAKS.extend(
        expand(
            join(RESULTSDIR, "{sample}", "peaks", "{sample}.virus.{virus}.macs2_peaks.narrowPeak"),
            sample=CASE_SAMPLES,
            virus=VIRUS_LIST,
        )
    )
    VIRUS_PEAKS.extend(
        expand(
            join(RESULTSDIR, "{sample}", "peaks", "{sample}.virus.{virus}.macs2_summits.bed"),
            sample=CASE_SAMPLES,
            virus=VIRUS_LIST,
        )
    )
    VIRUS_PEAKS.extend(
        expand(
            join(RESULTSDIR, "{sample}", "peaks", "{sample}.virus.{virus}.macs2_peaks.xls"),
            sample=CASE_SAMPLES,
            virus=VIRUS_LIST,
        )
    )
    VIRUS_PEAKS.extend(
        expand(
            join(RESULTSDIR, "{sample}", "peaks", "{sample}.virus.{virus}.genrich.narrowPeak"),
            sample=CASE_SAMPLES,
            virus=VIRUS_LIST,
        )
    )

HOST_TSS = []
if HOST != "":
    HOST_TSS.extend(
        [
            join(REF_DIR, "ref.tss.host.bed"),
            join(REF_DIR, "ref.chrom.sizes.host.txt"),
        ]
    )

VIRUS_TSS = []
if len(VIRUS_LIST) > 0:
    VIRUS_TSS.extend(expand(join(REF_DIR, "ref.tss.{virus}.bed"), virus=VIRUS_LIST))
    VIRUS_TSS.extend(
        expand(join(REF_DIR, "ref.chrom.sizes.{virus}.txt"), virus=VIRUS_LIST)
    )
    VIRUS_TSS.extend(
        expand(join(REF_DIR, "ref.chrom.autosomes.{virus}.txt"), virus=VIRUS_LIST)
    )

