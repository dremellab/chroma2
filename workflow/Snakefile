        expand(join(RESULTSDIR, "{sample}", "fastqc", "{sample}.raw_R2_fastqc.html"), sample=SAMPLES),
        expand(join(RESULTSDIR, "{sample}", "fastqc", "{sample}.raw_R2_fastqc.zip"), sample=SAMPLES),
        # fastqc on trimmed reads
        expand(join(RESULTSDIR, "{sample}", "fastqc", "{sample}.trimmed_R1_fastqc.html"), sample=SAMPLES),
        expand(join(RESULTSDIR, "{sample}", "fastqc", "{sample}.trimmed_R1_fastqc.zip"), sample=SAMPLES),
        expand(join(RESULTSDIR, "{sample}", "fastqc", "{sample}.trimmed_R2_fastqc.html"), sample=SAMPLES),
        expand(join(RESULTSDIR, "{sample}", "fastqc", "{sample}.trimmed_R2_fastqc.zip"), sample=SAMPLES),
        # bowtie2 alignments + stats
        expand(join(RESULTSDIR, "{sample}", "align", "{sample}.aligned.sorted.bam"), sample=SAMPLES),
        expand(join(RESULTSDIR, "{sample}", "align", "{sample}.aligned.idxstats.txt"), sample=SAMPLES),
        expand(join(RESULTSDIR, "{sample}", "align", "{sample}.aligned.flagstat.txt"), sample=SAMPLES),
        # bowtie2 filtered outputs + stats
