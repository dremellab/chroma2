def runlocal(
    workdir: pathlib.Path,
    env: Dict[str, str],
    module_load: str,
    conda_activate: str,
    path_prepend: str,
) -> None:
    if not os.environ.get("SLURM_JOB_ID"):
        err("runlocal can only be done on an interactive node")

    log_step("[runlocal] Starting local interactive execution")
    check_not_already_running(workdir)

    cmd = [
        "snakemake",
        "-s",
        str(SNAKEFILE),
        "--directory",
        str(workdir),
        "-j",
        "100",
        "--verbose",
    ]
    if env.get("APPTAINER_PREFIX_ARG"):
        cmd.append(env["APPTAINER_PREFIX_ARG"])
    cmd_str = " ".join(shlex.quote(str(c)) for c in cmd)
    parts = [p for p in [path_prepend, conda_activate, module_load] if p]
    if parts:
        cmd_str = " && ".join(parts + [cmd_str])

    timestamp = dt.datetime.now().strftime("%y%m%d%H%M%S")
    logs_dir = ensure_logs_folder(workdir)
    runlocal_log = logs_dir / f"runlocal.{timestamp}.log"
    marker = workdir / "pipeline.running"

    log_divider()
    write_pipeline_state_marker(
        workdir, "running", reason="runlocal_started", runmode="runlocal"
    )

    # Background thread: tails runlocal_log for Snakemake's own progress line
    # and periodically writes a snapshot into pipeline.running.
    stop_event = threading.Event()
    monitor = threading.Thread(
        target=run_progress_monitor,
        args=(marker, runlocal_log, stop_event),
        daemon=True,
    )
    monitor.start()

    # snakemake/tee are grandchildren (spawned by the intermediate `bash -lc`
    # process), not direct children of this process, so a plain signal-forward
    # to the bash PID isn't enough: a non-interactive bash that receives a
    # signal directly (not via terminal job control) typically dies without
    # forwarding it to its own children, orphaning snakemake and denying it
    # the chance to run its own graceful shutdown (which is what actually
    # cancels any per-rule SLURM sub-jobs it already submitted). Launching in
    # a new session makes bash the leader of its own process group, so the
    # whole subtree can be signaled at once via os.killpg().
    cmd_with_tee = cmd_str + f" 2>&1 | tee {shlex.quote(str(runlocal_log))}"
    proc = subprocess.Popen(
        ["bash", "-lc", cmd_with_tee], env=env, start_new_session=True
    )

    def _handle_signal(signum, _frame):
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signum)
            except ProcessLookupError:
                pass
            try:
                proc.wait(timeout=30)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                proc.wait()
        write_pipeline_state_marker(
            workdir,
            "canceled",
            reason=f"signal_{signal.Signals(signum).name}",
            runmode="runlocal",
        )
        sys.exit(130)

    old_sigterm = signal.signal(signal.SIGTERM, _handle_signal)
    old_sigint = signal.signal(signal.SIGINT, _handle_signal)
    try:
        rc = proc.wait()
    finally:
        signal.signal(signal.SIGTERM, old_sigterm)
        signal.signal(signal.SIGINT, old_sigint)
        stop_event.set()
        monitor.join(timeout=5)

    if rc == 0:
        content = derive_final_progress(runlocal_log)
        write_pipeline_state_marker(
            workdir,
            "completed",
            reason="runlocal_succeeded",
            runmode="runlocal",
            content=content,
        )
        log_ok("Local run completed successfully")
        return

    last_progress = marker.read_text() if marker.exists() else ""
    digest = extract_failed_rules_digest(runlocal_log)
    failed_rules = [format_digest_line(d) for d in digest]
    content = last_progress
    if failed_rules:
        content += f"\n{len(failed_rules)} job(s) failed:\n" + "\n".join(failed_rules)
    write_pipeline_state_marker(
        workdir,
        "failed",
        reason="runlocal_failed",
        runmode="runlocal",
        content=content,
        num_failed_rules=len(failed_rules),
        failed_rules=failed_rules,
    )
    log_error(f"Local run failed (exit code {rc})")
    sys.exit(rc)


def write_sbatch_script(
    workdir: pathlib.Path,
    profile: str,
    apptainer_vars: Dict[str, str],
    module_load: str,
    conda_activate: str,
    path_prepend: str,
    partition: Optional[str],
) -> pathlib.Path:
    sbatch_path = workdir / "run_head_job.sbatch"
    cfg = {}
    cfg_path = workdir / "config.yaml"
    if cfg_path.exists():
        try:
            cfg = yaml.safe_load(cfg_path.read_text()) or {}
        except Exception:
            cfg = {}
    account = str(cfg.get("slurm_account", "dremel_lab")).strip() or "dremel_lab"
    if not partition:
        partition = str(cfg.get("slurm_partition", "")).strip() or "standard"
    part_line = f"#SBATCH --partition={partition}"
    acct_line = f"#SBATCH --account={account}"
    apptainer_exports = "\n".join(
        f'export {k}="{v}"' for k, v in apptainer_vars.items()
    )
    apptainer_prefix = ""
    if apptainer_vars.get("APPTAINER_SIF_DIR"):
        apptainer_prefix = f'--apptainer-prefix={apptainer_vars["APPTAINER_SIF_DIR"]}'

    chroma2_bin = shlex.quote(str(PIPELINE_HOME / "chroma2"))
    workdir_q = shlex.quote(str(workdir))
    finalize = (
        f"{chroma2_bin} --internal-finalize --workdir {workdir_q} "
        f'--job-id "$SLURM_JOB_ID" --log-file {workdir_q}/logs/slurm-$SLURM_JOB_ID.out'
    )

    lines = [
        "#!/bin/bash",
        "# Auto-generated by chroma2 wrapper",
        "#SBATCH --cpus-per-task=2",
        "#SBATCH --mem=40G",
        "#SBATCH --time=3-00:00:00",
        acct_line,
        "#SBATCH --job-name=chroma2_head_job",
        f"#SBATCH --output={workdir_q}/logs/slurm-%j.out",
        part_line,
        "",
        "set -euo pipefail",
        "",
        f"cd {workdir_q}",
        "",
        # Slurm can terminate this job directly (scancel, walltime) before the
        # snakemake exit-code branch below ever runs, so a trap is the only
        # reliable way to record pipeline.canceled in that case. The handler
        # explicitly kills the background progress monitor and signals/waits
        # on the snakemake child (backgrounded below) before finalizing --
        # snakemake's own signal handling is what actually cancels any
        # per-rule SLURM sub-jobs it already submitted, so it needs a chance
        # to run before this script records pipeline.canceled and exits.
        "_handle_signal() {",
        '  local sig="$1"',
        '  kill "${_monitor_pid:-}" 2>/dev/null || true',
        '  if [ -n "${SNAKEMAKE_PID:-}" ]; then',
        '    kill -TERM "$SNAKEMAKE_PID" 2>/dev/null || true',
        '    wait "$SNAKEMAKE_PID" 2>/dev/null || true',
        "  fi",
        f'  {finalize} --state canceled --reason "signal_${{sig}}"',
        "  exit 130",
        "}",
        "trap '_handle_signal SIGTERM' SIGTERM",
        "trap '_handle_signal SIGINT' SIGINT",
        "",
    ]
    if apptainer_exports:
        lines.append(apptainer_exports)
    profile_dir_q = shlex.quote(f"{workdir}/config/{profile}")
    lines.append(f"export PROFILE={profile_dir_q}")
    if path_prepend:
        lines.append(path_prepend)
    if conda_activate:
        lines.append(conda_activate)
    if module_load:
        lines.append(module_load)
    lines.extend(
        [
            "",
            "echo '" + "-" * 66 + "'",
            "echo 'STEP  [head_job] Starting Snakemake head process'",
            "echo '" + "-" * 66 + "'",
            "",
            "# Background loop: tails this job's own stdout for Snakemake's progress",
            "# line and periodically snapshots it into pipeline.running.",
            "_progress_monitor() {",
            f"  local logfile={workdir_q}/logs/slurm-$SLURM_JOB_ID.out",
            f"  local marker={workdir_q}/pipeline.running",
            '  while [[ -f "$marker" ]]; do',
            '    if [[ -f "$logfile" ]]; then',
            "      raw=$(grep -oP '[0-9]+ of [0-9]+ steps \\([0-9]+%\\) done' \"$logfile\" 2>/dev/null | tail -1 || true)",
            '      if [[ -n "$raw" ]]; then',
            "        done_n=$(printf '%s' \"$raw\" | grep -oP '^[0-9]+' || true)",
            "        total_n=$(printf '%s' \"$raw\" | grep -oP '(?<=of )[0-9]+' || true)",
            "        pct=$(printf '%s' \"$raw\" | grep -oP '[0-9]+(?=%)' || true)",
            '        if [[ -n "$done_n" && -n "$total_n" && -n "$pct" ]]; then',
            "          remaining=$(( total_n - done_n )); (( remaining < 0 )) && remaining=0",
            "          printf 'Progress : %s / %s steps complete (%s%%)\\nRemaining: %s steps\\nUpdated  : %s\\n' \\",
            '            "$done_n" "$total_n" "$pct" "$remaining" "$(date \'+%Y-%m-%d %H:%M:%S\')" > "$marker"',
            "        fi",
            "      fi",
            "    fi",
            "    sleep 60",
            "  done",
            "}",
            "_progress_monitor &",
            "_monitor_pid=$!",
            "",
            "set +e",
            f"snakemake -s {SNAKEFILE} --directory {workdir_q} -j 100 --verbose {apptainer_prefix} --profile config/{profile} &",
            "SNAKEMAKE_PID=$!",
            'wait "$SNAKEMAKE_PID"',
            "SNAKEMAKE_EXIT_CODE=$?",
            "set -e",
            "",
            'kill "$_monitor_pid" 2>/dev/null || true',
            'wait "$_monitor_pid" 2>/dev/null || true',
            "",
            "if [ $SNAKEMAKE_EXIT_CODE -eq 0 ]; then",
            f"    {finalize} --state completed --reason snakemake_succeeded",
            "    echo 'OK    [head_job] Snakemake completed successfully'",
            "else",
            f"    {finalize} --state failed --reason snakemake_failed",
            "    echo 'ERROR [head_job] Snakemake failed (exit code '$SNAKEMAKE_EXIT_CODE')'",
            "fi",
            "",
            "exit $SNAKEMAKE_EXIT_CODE",
        ]
    )
    script = "\n".join(line for line in lines if line is not None) + "\n"
    sbatch_path.write_text(script)
    return sbatch_path


def printbinds(profile_path: pathlib.Path) -> None:
    if not profile_path.exists():
        err(f"Profile not found: {profile_path}")
    apptainer_args = ""
    with profile_path.open() as f:
        for line in f:
            if line.strip().startswith("apptainer-args:"):
                apptainer_args = line.split(":", 1)[1].strip()
                break
    print(apptainer_args)


def main() -> None:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-m", "--runmode")
    parser.add_argument("-w", "--workdir")
    parser.add_argument("-g", "--host")
    parser.add_argument("-a", "--additives")
    parser.add_argument("-v", "--viruses")
    parser.add_argument("-s", "--manifest")
    parser.add_argument("-i", "--sifdir")
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("-V", "--version", action="store_true")
    # Hidden: only ever invoked by the generated sbatch script (write_sbatch_script)
    # to finalize pipeline.* state from a detached process, instead of
    # duplicating write_pipeline_state_marker/extract_failed_rules_digest in bash.
    parser.add_argument(
        "--internal-finalize", action="store_true", help=argparse.SUPPRESS
    )
    parser.add_argument(
        "--state", choices=["completed", "failed", "canceled"], help=argparse.SUPPRESS
    )
    parser.add_argument("--reason", default="", help=argparse.SUPPRESS)
    parser.add_argument("--job-id", default="NA", help=argparse.SUPPRESS)
    parser.add_argument("--log-file", default=None, help=argparse.SUPPRESS)
    args = parser.parse_args()

    if args.internal_finalize:
        workdir = pathlib.Path(args.workdir).expanduser().resolve()
        logfile = pathlib.Path(args.log_file) if args.log_file else None
        marker = workdir / "pipeline.running"
        content, num_failed, failed_rules = "", 0, []
        if args.state == "completed":
            content = derive_final_progress(logfile) if logfile else ""
        elif args.state == "failed":
            last_progress = marker.read_text() if marker.exists() else ""
            if logfile:
                digest = extract_failed_rules_digest(logfile)
                failed_rules = [format_digest_line(d) for d in digest]
                num_failed = len(failed_rules)
            content = last_progress
            if failed_rules:
                content += f"\n{num_failed} job(s) failed:\n" + "\n".join(failed_rules)
            elif logfile:
                content += (
                    f"\nNo per-rule failure details could be parsed from {logfile} -- "
                    "either no Snakemake rule failed directly (e.g. a config/setup "
                    "error before any rule ran) or the log format has changed since "
                    "this parser was written. Check the log directly for the real error."
                )
        write_pipeline_state_marker(
            workdir,
            args.state,
            reason=args.reason,
            job_id=args.job_id,
            content=content,
            num_failed_rules=num_failed,
            failed_rules=failed_rules,
            runmode="run",
        )
        sys.exit(0)

    if args.version:
        version_path = PIPELINE_HOME / "VERSION"
        if version_path.exists():
            version = version_path.read_text().strip().split()[0]
        else:
            version = "unknown"
        print(version)
        sys.exit(0)

    if args.help or not args.runmode or not args.workdir:
        print(usage())
        sys.exit(0 if args.help else 1)

    workdir = pathlib.Path(args.workdir).expanduser().resolve()
    platform = get_platform()

    cluster_profile = "unknown"
    partition = None
    module_load = ""
    conda_activate = ""
    path_prepend = ""
    temp_dir = f"/scratch/{getpass.getuser()}/tmpdir"
    refs_dir = "/project/dremel_lab/workflows/reference_data/fasta_gtf/"
    kraken2_db = "/project/dremel_lab/workflows/reference_data/kraken2/kraken2_db"

    if platform == "shen":
        cluster_profile = "rivanna"
        partition = "standard"
        py_bin = "/sfs/gpfs/tardis/project/dremel_lab/miniforge3/envs/pipelines/bin"
        path_prepend = f'export PATH="{py_bin}:/project/dremel_lab/scripts/bin:$PATH"'
        module_load = "module load apptainer"
    else:
        print(
            f'WARNING: detected platform is "{platform}". '
            "Please edit config/ and config.yaml for compatibility with your environment."
        )

    host = args.host or "hg38_basic"
    additives = args.additives or ""
    viruses = args.viruses or "KT899744.1"

    runmode = args.runmode

    def do_init() -> None:
        if workdir.exists():
            err(f"Folder {workdir} already exists!")
        log_step("[init] Preparing workdir")
        workdir.mkdir(parents=True)
        copy_config_profiles(workdir)

        log_info("Editing config.yaml with the following parameters:")
        log_info(f"Pipeline Dir: {PIPELINE_HOME}")
        log_info(f"Host: {host}")
        log_info(f"Additives: {additives}")
        log_info(f"Viruses: {viruses}")
        log_info(f"Temp Dir: {temp_dir}")
        log_info(f"Refs Dir: {refs_dir}")
        log_info(f"Cluster Profile: {cluster_profile}")
        write_config(workdir, host, additives, viruses, temp_dir, refs_dir, kraken2_db)
        log_ok(f"Completed writing {workdir}/config.yaml")

        manifest = args.manifest
        if manifest:
            manifest_path = pathlib.Path(manifest).expanduser().resolve()
            if not manifest_path.exists():
                err(f"Manifest file {manifest_path} does not exist!")
            shutil.copy2(manifest_path, workdir / "samples.tsv")
        else:
            default_manifest = PIPELINE_HOME / "config" / "samples.tsv"
            if default_manifest.exists():
                shutil.copy2(default_manifest, workdir / "samples.tsv")
            else:
                write_samples_template(workdir / "samples.tsv")

        default_contrasts = PIPELINE_HOME / "config" / "contrasts.tsv"
        if default_contrasts.exists():
            shutil.copy2(default_contrasts, workdir / "contrasts.tsv")
            log_ok(f"Copied contrasts file to {workdir}/contrasts.tsv")

        (workdir / "logs").mkdir(exist_ok=True)
        (workdir / "stats").mkdir(exist_ok=True)
        log_ok(f"Initialization completed for {workdir}")
        log_next(
            f"Edit {workdir}/config.yaml and {workdir}/samples.tsv, then run: chroma2 -w {workdir} -m dryrun"
        )

    if runmode == "init":
        do_init()
        return

    if runmode in {"reconfig"}:
        log_step("[reconfig] Rebuilding config.yaml")
        check_essential_files(workdir)
        write_config(workdir, host, additives, viruses, temp_dir, refs_dir, kraken2_db)
        log_ok(f"{workdir}/config.yaml has been updated!")
        return

    if runmode in {"recluster"}:
        log_step("[recluster] Syncing cluster config into workdir")
        check_essential_files(workdir)
        copy_config_profiles(workdir)
        log_ok("Done reclustering!")
        return

    if runmode in {"reset"}:
        if not workdir.exists():
            err(f"Folder {workdir} does not exist!")
        log_info(f"Working Dir: {workdir}")
        log_warn(f"Deleting {workdir}")
        shutil.rmtree(workdir)
        log_step(f"Re-Initializing {workdir}")
        do_init()
        return

    if runmode in {"printbinds"}:
        profile_path = workdir / "config" / cluster_profile / "config.yaml"
        printbinds(profile_path)
        return

    # runtime paths/env setup
    check_essential_files(workdir)
    apptainer_vars = resolve_apptainer_paths(args.sifdir)
    profile_dir = workdir / "config" / cluster_profile
    env = build_env(profile_dir, apptainer_vars)

    if runmode in {"dryrun", "dry"}:
        log_step("[dryrun] Running preflight checks")
        create_runinfo(workdir)
        if is_workdir_locked(workdir):
            print(
                "WARNING: workdir appears to be locked by Snakemake (.snakemake/lock exists). "
                "If this is stale, run `chroma2 -w <WORKDIR> -m unlock` before proceeding."
            )
        timestamp = dt.datetime.now().strftime("%y%m%d%H%M%S")
        logs_dir = ensure_logs_folder(workdir)
        log_path = logs_dir / f"dryrun.{timestamp}.log"
        cmd = [
            "snakemake",
            "-s",
            str(SNAKEFILE),
            "--directory",
            str(workdir),
            "-j",
            "100",
            "--verbose",
        ]
        if env.get("APPTAINER_PREFIX_ARG"):
            cmd.append(env["APPTAINER_PREFIX_ARG"])
        cmd.extend(["--profile", f"config/{cluster_profile}", "--dry-run"])
        cmd_str = (
            " ".join(shlex.quote(str(c)) for c in cmd)
            + f" | tee {shlex.quote(str(log_path))}"
        )
        parts = [p for p in [path_prepend, conda_activate, module_load] if p]
        if parts:
            cmd_str = " && ".join(parts + [cmd_str])
        log_divider()
        result = subprocess.run(["bash", "-lc", cmd_str], env=env)
        log_divider()
        if result.returncode != 0:
            log_error(
                f"Dry-run failed (exit code {result.returncode}). See log: {log_path}"
            )
            warn_if_already_running(workdir)
            sys.exit(result.returncode)
        log_ok(f"Dry-run completed. Log: {log_path}")
        dryrun_output = (
            log_path.read_text(errors="replace") if log_path.exists() else ""
        )
        if (workdir / "pipeline.running").exists():
            warn_if_already_running(workdir)
        elif "Nothing to be done" not in dryrun_output:
            log_next(f"Submit run with: chroma2 -w {workdir} -m run")
        return

    if runmode in {"touch"}:
        log_step("[touch] Touching output files")
        cmd = [
            "snakemake",
            "--touch",
            "-s",
            str(SNAKEFILE),
            "--directory",
            str(workdir),
            "--cores",
            "1",
        ]
        if env.get("APPTAINER_PREFIX_ARG"):
            cmd.append(env["APPTAINER_PREFIX_ARG"])
        try:
            shell_run(cmd, env, module_load, conda_activate, path_prepend)
        except subprocess.CalledProcessError as e:
            log_error(f"Touch failed (exit code {e.returncode}).")
            sys.exit(e.returncode)
        log_ok("Touch completed.")
        return

    if runmode in {"unlock"}:
        log_step("[unlock] Unlocking workdir")
        check_not_already_running(workdir)
        try:
            run_snakemake(
                workdir,
                f"config/{cluster_profile}",
                ["--unlock"],
                env,
                module_load,
                conda_activate,
                path_prepend,
            )
        except subprocess.CalledProcessError as e:
            log_error(f"Unlock failed (exit code {e.returncode})")
            sys.exit(e.returncode)
        log_ok("Workdir unlocked")
        return

    if runmode in {"runlocal", "local"}:
        write_run_metadata(
            workdir,
            runmode,
            cluster_profile,
            platform,
            " ".join(shlex.quote(str(c)) for c in sys.argv),
        )
        create_runinfo(workdir)
        runlocal(workdir, env, module_load, conda_activate, path_prepend)
        cleanup_tempdir(workdir)
        return

    if runmode in {"run"}:
        log_step("[run] Preparing SLURM submission")
        check_not_already_running(workdir)
        write_run_metadata(
            workdir,
            runmode,
            cluster_profile,
            platform,
            " ".join(shlex.quote(str(c)) for c in sys.argv),
        )
        create_runinfo(workdir)
        ensure_logs_folder(workdir)
        log_event(workdir, "INFO", "RUN_STARTED", "Workflow execution started")

        if shutil.which("sbatch") is None:
            err("sbatch not found in PATH; cannot submit head job to Slurm")
        sbatch_script = write_sbatch_script(
            workdir,
            cluster_profile,
            apptainer_vars,
            module_load,
            conda_activate,
            path_prepend,
            partition,
        )

        log_divider()
        write_pipeline_state_marker(
            workdir, "running", reason="submission_started", runmode="run"
        )

        try:
            jobid = subprocess.check_output(
                ["sbatch", "--parsable", str(sbatch_script)], text=True
            ).strip()
        except subprocess.CalledProcessError:
            write_pipeline_state_marker(
                workdir, "failed", reason="sbatch_submission_failed", runmode="run"
            )
            log_error(f"Failed to submit {sbatch_script}")
            sys.exit(1)

        write_pipeline_state_marker(
            workdir, "running", reason="sbatch_submitted", job_id=jobid, runmode="run"
        )
        log_event(workdir, "INFO", "SLURM_SUBMITTED", f"Job ID: {jobid}")

        log_divider()
        log_ok(
            f"Submitted head job as sbatch job {jobid}. Output: {workdir}/logs/slurm-{jobid}.out"
        )
        log_next("Monitor:  squeue -u $USER")
        log_next(f"Progress: tail -f {workdir}/logs/slurm-{jobid}.out")
        log_next(f"Status:   ls -1 {workdir}/pipeline.*")
        log_next(f"Sidecar:  cat {workdir}/pipeline.status.json")
        log_divider()
        return

    err(f'Unknown RUNMODE "{runmode}"')


if __name__ == "__main__":
    main()
