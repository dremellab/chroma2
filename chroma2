def err(message: str) -> None:
    msg_lines = [
        line.rstrip() for line in str(message).strip().splitlines() if line.strip()
    ]
    width = max([len("ERROR"), len("Details")] + [len(line) for line in msg_lines])
    border = f"+{'-' * (width + 2)}+"
    print(border, file=sys.stderr)
    print(f"| {'ERROR'.ljust(width)} |", file=sys.stderr)
    print(f"| {'Details'.ljust(width)} |", file=sys.stderr)
    for line in msg_lines:
        print(f"| {line.ljust(width)} |", file=sys.stderr)
    print(border, file=sys.stderr)
    print("Run `./chroma2 --help` for usage.", file=sys.stderr)
    sys.exit(1)


