def ensure_logs_folder(workdir: pathlib.Path) -> pathlib.Path:
    """Create logs folder if it doesn't exist."""
    logs_dir = workdir / "logs"
    logs_dir.mkdir(parents=True, exist_ok=True)
    return logs_dir


def log_event(workdir: pathlib.Path, level: str, event_type: str, message: str) -> None:
    """Log event to both events.log and events.jsonl."""
    logs_dir = ensure_logs_folder(workdir)
    timestamp = dt.datetime.now().isoformat()

    # Write to events.log (human-readable)
    with open(logs_dir / "events.log", "a") as f:
        f.write(f"[{timestamp}] {level}: {event_type} - {message}\n")

    # Write to events.jsonl (machine-readable)
    with open(logs_dir / "events.jsonl", "a") as f:
        json.dump(
            {
                "timestamp": timestamp,
                "level": level,
                "event": event_type,
                "message": message,
            },
            f,
        )
        f.write("\n")


##########################################################################################
# pipeline.* run-state markers + status sidecar (mirrors HAROLD's write_pipeline_state_marker)
##########################################################################################

PIPELINE_STATES = ("running", "completed", "failed", "canceled")


def write_pipeline_state_marker(
    workdir: pathlib.Path,
    state: str,
    reason: str = "",
    job_id: str = "NA",
    content: str = "",
    num_failed_rules: int = 0,
    failed_rules: Optional[List[str]] = None,
    runmode: str = "",
) -> None:
    """Write a single state marker file (pipeline.<state>) and a JSON status
    sidecar (pipeline.status.json) in workdir. The new marker is written
    before sibling states are removed, so a poller never sees zero
    pipeline.* files."""
    failed_rules = failed_rules or []

    marker_path = workdir / f"pipeline.{state}"
    if content:
        marker_path.write_text(content)
    else:
        marker_path.touch()
    for other_state in PIPELINE_STATES:
        if other_state == state:
            continue
        (workdir / f"pipeline.{other_state}").unlink(missing_ok=True)

    version_path = PIPELINE_HOME / "VERSION"
    version = (
        version_path.read_text().strip().split()[0]
        if version_path.exists()
        else "unknown"
    )
    git_meta = get_git_metadata(PIPELINE_HOME)
    sidecar = {
        "pipeline": "chroma2",
        "version": version,
        "git_commit_tag": f"{git_meta['commit']}\t{git_meta['tag']}",
        "state": state,
        "reason": reason,
        "runmode": runmode,
        "workdir": str(workdir),
        "slurm_job_id": job_id,
        "host": socket.gethostname(),
        "num_failed_rules": num_failed_rules,
        "failed_rules": failed_rules,
        "timestamp_utc": dt.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    sidecar_path = workdir / "pipeline.status.json"
    tmp_path = sidecar_path.with_name(sidecar_path.name + f".tmp.{os.getpid()}")
    tmp_path.write_text(json.dumps(sidecar, indent=2))
    tmp_path.replace(sidecar_path)
    log_info(
        f"State marker updated: pipeline.{state} (reason={reason}, slurm_job_id={job_id})"
    )


def _stale_running_marker(workdir: pathlib.Path) -> Optional[str]:
    """Return the terminal state name if pipeline.running coexists with a
    terminal pipeline.<state> marker. write_pipeline_state_marker() touches
    the new marker before unlinking siblings, so a kill in that gap leaves
    both a terminal marker and the old pipeline.running behind -- this can
    only happen for a run that already reached a terminal state, since a
    genuinely active run's own pipeline.running write already cleared any
    prior terminal marker (in the same call, before this check ever runs).
    Returns None if pipeline.running doesn't exist, or exists with no
    terminal marker alongside it (a genuinely active run)."""
    if not (workdir / "pipeline.running").exists():
        return None
    for state in ("completed", "failed", "canceled"):
        if (workdir / f"pipeline.{state}").exists():
            return state
    return None


def check_not_already_running(workdir: pathlib.Path) -> None:
    """Refuse to proceed while a prior run still looks active (or crashed
    without cleaning up) in this workdir. Called from run/runlocal/unlock
    before submitting/starting/unlocking."""
    stale_state = _stale_running_marker(workdir)
    if stale_state is not None:
        log_warn(
            f"Found stale {workdir}/pipeline.running alongside pipeline.{stale_state} -- "
            "a previous run finished but was killed before removing pipeline.running. "
            "Removing the stale marker and proceeding."
        )
        (workdir / "pipeline.running").unlink(missing_ok=True)
        return
    if (workdir / "pipeline.running").exists():
        err(
            f"Found {workdir}/pipeline.running -- a run already appears to be in progress "
            "(or a previous run crashed without cleaning up). Confirm no run is active, "
            "then remove this file before retrying."
        )


def warn_if_already_running(workdir: pathlib.Path) -> None:
    """Unlike check_not_already_running, this does not abort -- dryrun is
    read-only/inspection and legitimately useful while a run is in progress."""
    if _stale_running_marker(workdir) is not None:
        return
    if (workdir / "pipeline.running").exists():
        log_warn(
            f"Found {workdir}/pipeline.running -- a pipeline run may already be in progress "
            "(or a previous run crashed without cleaning up) in this workdir. "
            "'chroma2 -m run'/'runlocal'/'unlock' will refuse to proceed while this file exists."
        )


##########################################################################################
# failed-rule digest ... scrape Snakemake's own "Error in rule" blocks from a log
##########################################################################################

_RULE_RE = re.compile(r"^Error in rule (.+):$")
_JOBID_RE = re.compile(r"^\s{4}jobid: (\d+)$")
_MESSAGE_RE = re.compile(r"^\s{4}message: (.*)$")
_LOG_RE = re.compile(r"^\s{4}log: (.*) \(check log file\(s\) for error details\)$")
_SLURM_FAIL_RE = re.compile(
    r"SLURM-job '(\d+)' failed, SLURM status is: '([A-Za-z_]+)'"
)
_FINISHED_JOBID_RE = re.compile(r"Finished jobid: (\d+)")
_PROGRESS_RE = re.compile(r"(\d+) of (\d+) steps \((\d+)%\) done")


def extract_failed_rules_digest(logfile: pathlib.Path) -> List[Dict[str, str]]:
    """Best-effort scrape of Snakemake's own log for "Error in rule" blocks.
    A jobid whose block is later followed by a matching "Finished jobid: <id>"
    line succeeded on retry (restart-times) and is dropped."""
    if not logfile.exists():
        return []

    finished_jobids = set(
        _FINISHED_JOBID_RE.findall(logfile.read_text(errors="replace"))
    )

    digests: "Dict[str, Dict[str, str]]" = {}
    in_block = False
    rule = jobid = message = logline = ""
    for line in logfile.read_text(errors="replace").splitlines():
        rule_match = _RULE_RE.match(line)
        if rule_match:
            in_block = True
            rule = rule_match.group(1)
            jobid = message = logline = ""
            continue
        if not in_block:
            continue
        if line.strip() == "":
            if jobid:
                slurm_job, state = "NA", "NA"
                slurm_match = _SLURM_FAIL_RE.search(message)
                if slurm_match:
                    slurm_job, state = slurm_match.group(1), slurm_match.group(2)
                log_path, sample = "NA", "NA"
                if logline:
                    log_path = logline.split(",", 1)[0].strip()
                    sample = pathlib.Path(log_path).parent.name or "NA"
                digests[jobid] = {
                    "rule": rule,
                    "jobid": jobid,
                    "slurm_job": slurm_job,
                    "state": state,
                    "sample": sample,
                    "log": log_path,
                }
            in_block = False
            continue
        jobid_match = _JOBID_RE.match(line)
        message_match = _MESSAGE_RE.match(line)
        log_match = _LOG_RE.match(line)
        if jobid_match:
            jobid = jobid_match.group(1)
        elif not message and message_match:
            message = message_match.group(1)
        elif not logline and log_match:
            logline = log_match.group(1)

    return [d for jid, d in digests.items() if jid not in finished_jobids]


def format_digest_line(d: Dict[str, str]) -> str:
    return (
        f"FAILED: rule={d['rule']} jobid={d['jobid']} slurm_job={d['slurm_job']} "
        f"state={d['state']} sample={d['sample']} log={d['log']}"
    )


def derive_final_progress(logfile: pathlib.Path) -> str:
    """Re-derive the final step count from Snakemake's own last progress line
    and report it as N/N (100%, 0 remaining)."""
    if not logfile.exists():
        return ""
    matches = _PROGRESS_RE.findall(logfile.read_text(errors="replace"))
    if not matches:
        return ""
    _, total, _ = matches[-1]
    updated = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    return (
        f"Progress : {total} / {total} steps complete (100%)\n"
        f"Remaining: 0 steps\n"
        f"Updated  : {updated}\n"
    )


def progress_snapshot(logfile: pathlib.Path) -> Optional[str]:
    """Scrape the latest 'N of M steps (P%) done' line for a live snapshot."""
    if not logfile.exists():
        return None
    matches = _PROGRESS_RE.findall(logfile.read_text(errors="replace"))
    if not matches:
        return None
    done_n, total_n, pct = matches[-1]
    remaining = max(int(total_n) - int(done_n), 0)
    updated = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    return (
        f"Progress : {done_n} / {total_n} steps complete ({pct}%)\n"
        f"Remaining: {remaining} steps\n"
        f"Updated  : {updated}\n"
    )


def run_progress_monitor(
    marker: pathlib.Path, logfile: pathlib.Path, stop_event: threading.Event
) -> None:
    """Background loop: tails `logfile` for Snakemake's own progress line and
    periodically writes a human-readable progress summary into `marker`
    (pipeline.running), mirroring HAROLD's _runlocal_progress_monitor."""
    while not stop_event.is_set():
        if not marker.exists():
            break
        snapshot = progress_snapshot(logfile)
        if snapshot:
            marker.write_text(snapshot)
        stop_event.wait(60)


