def get_platform() -> str:
    if shutil.which("scontrol") is None:
        return "unknown"
    try:
        out = subprocess.check_output(
            ["scontrol", "show", "config"], text=True, stderr=subprocess.DEVNULL
        )
    except subprocess.CalledProcessError:
        return "unknown"
    for line in out.splitlines():
        if "ClusterName" in line:
            return line.split()[-1].strip()
    return "unknown"


def get_git_commit_tag(repo: pathlib.Path) -> str:
    try:
        gid = subprocess.check_output(
            ["git", "-C", str(repo), "rev-parse", "HEAD"], text=True
        ).strip()
        try:
            tag = subprocess.check_output(
                ["git", "-C", str(repo), "describe", "--tags", gid],
                text=True,
                stderr=subprocess.DEVNULL,
            ).strip()
        except subprocess.CalledProcessError:
            tag = "No Tags"
        return f"{gid}\t{tag}"
    except Exception:
        return "unknown\tNo Tags"


def get_git_metadata(repo: pathlib.Path) -> Dict[str, str]:
    gid = "unknown"
    tag = "No Tags"
    dirty = "unknown"
    try:
        gid = subprocess.check_output(
            ["git", "-C", str(repo), "rev-parse", "HEAD"], text=True
        ).strip()
        try:
            tag = subprocess.check_output(
                ["git", "-C", str(repo), "describe", "--tags", gid],
                text=True,
                stderr=subprocess.DEVNULL,
            ).strip()
        except subprocess.CalledProcessError:
            tag = "No Tags"
        try:
            status = subprocess.check_output(
                ["git", "-C", str(repo), "status", "--porcelain"], text=True
            )
            dirty = "true" if status.strip() else "false"
        except subprocess.CalledProcessError:
            dirty = "unknown"
    except Exception:
        pass
    return {"commit": gid, "tag": tag, "dirty": dirty}


def sha256_file(path: pathlib.Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def read_yaml(path: pathlib.Path) -> Dict[str, object]:
    try:
        with path.open("r") as f:
            return yaml.safe_load(f) or {}
    except Exception:
        return {}


def split_csv(value: str) -> list:
    return [v.strip() for v in value.split(",") if v.strip()]


def write_run_metadata(
    workdir: pathlib.Path,
    runmode: str,
    cluster_profile: str,
    platform: str,
    command: str,
) -> pathlib.Path:
    timestamp = dt.datetime.utcnow().strftime("%Y-%m-%dT%H-%M-%SZ")
    outfile = workdir / f"run_metadata.{timestamp}.json"
    config_path = workdir / "config.yaml"
    samples_path = workdir / "samples.tsv"

    config = read_yaml(config_path) if config_path.exists() else {}
    host = str(config.get("host", "") or "")
    viruses = str(config.get("viruses", "") or "")
    additives = str(config.get("additives", "") or "")
    containers = config.get("containers", {}) if isinstance(config, dict) else {}

    payload = {
        "pipeline": {
            "name": "chroma2",
            "version": (PIPELINE_HOME / "VERSION").read_text().strip().split()[0]
            if (PIPELINE_HOME / "VERSION").exists()
            else "unknown",
            "git": get_git_metadata(PIPELINE_HOME),
        },
        "run": {
            "timestamp_written": timestamp,
            "runmode": runmode,
            "workdir": str(workdir),
            "resultsdir": str(workdir / "results"),
            "profile": cluster_profile,
            "platform": platform,
            "user": getpass.getuser(),
            "hostname": socket.gethostname(),
            "command": command,
        },
        "inputs": {
            "config_path": str(config_path),
            "samples_path": str(samples_path),
            "config_sha256": sha256_file(config_path) if config_path.exists() else "",
            "samples_sha256": sha256_file(samples_path)
            if samples_path.exists()
            else "",
            "references": {
                "host": host,
                "viruses": split_csv(viruses),
                "additives": split_csv(additives),
            },
        },
        "software": {"containers": containers},
    }

    outfile.write_text(json.dumps(payload, indent=2, sort_keys=True))
    return outfile


def require_env(var: str, hint: str) -> None:
    if not os.environ.get(var):
        err(f"{var} is not set in the environment. {hint}")


