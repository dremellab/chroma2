def render_template(template: str, mapping: Dict[str, str]) -> str:
    for key, value in mapping.items():
        template = template.replace(key, value)
    return template


def write_config(
    workdir: pathlib.Path,
    host: str,
    additives: str,
    viruses: str,
    temp_dir: str,
    refs_dir: str,
    kraken2_db: str,
) -> None:
    template = read_config_template()
    temp_dir = str(pathlib.Path(temp_dir) / str(uuid.uuid4()))
    pathlib.Path(temp_dir).mkdir(parents=True, exist_ok=True)
    rendered = render_template(
        template,
        {
            "PIPELINE_HOME": str(PIPELINE_HOME),
            "WORKDIR": str(workdir),
            "HOST": host,
            "ADDITIVES": additives,
            "VIRUSES": viruses,
            "TEMP_DIR": temp_dir,
            "REFS_DIR": refs_dir,
            "KRAKEN2_DB": kraken2_db,
        },
    )
    (workdir / "config.yaml").write_text(rendered)


def write_samples_template(path: pathlib.Path) -> None:
    header = "sampleName\tgroupName\tpath_to_R1_fastq\tpath_to_R2_fastq\n"
    path.write_text(header)


def copy_config_profiles(workdir: pathlib.Path) -> None:
    src = PIPELINE_HOME / "config"
    dst = workdir / "config"
    if src.exists():
        shutil.copytree(src, dst, dirs_exist_ok=True)


def check_essential_files(workdir: pathlib.Path) -> None:
    if not workdir.exists():
        err(f"Folder {workdir} does not exist!")
    if not (workdir / "config.yaml").exists():
        err("Missing config.yaml in workdir ... initialize first!")


def resolve_apptainer_paths(sif_dir_override: Optional[str]) -> Dict[str, str]:
    hint = (
        "This is set in the pipelines environment. "
        "If you are running into this error reach out to cud2td@virginia.edu."
    )
    require_env("SINGULARITY_CACHEDIR", hint)
    require_env("SINGULARITY_TMPDIR", hint)
    require_env("SINGULARITY_PULLFOLDER", hint)
    require_env("DEFAULT_SHARED_SIF_DIR", hint)

    apptainer_sif_dir = sif_dir_override or os.environ["DEFAULT_SHARED_SIF_DIR"]
    sing_cache = os.environ["SINGULARITY_CACHEDIR"]
    sing_tmp = os.environ["SINGULARITY_TMPDIR"]
    sing_pull = os.environ["SINGULARITY_PULLFOLDER"]
    return {
        "APPTAINER_SIF_DIR": apptainer_sif_dir,
        "APPTAINER_CACHEDIR": sing_cache,
        "APPTAINER_TMPDIR": sing_tmp,
        "APPTAINER_PULLDIR": sing_pull,
        "APPTAINER_PULLFOLDER": sing_pull,
        # keep Singularity vars aligned to avoid warnings
        "SINGULARITY_CACHEDIR": sing_cache,
        "SINGULARITY_TMPDIR": sing_tmp,
        "SINGULARITY_PULLFOLDER": sing_pull,
    }


def build_env(
    profile_dir: pathlib.Path, apptainer_vars: Dict[str, str]
) -> Dict[str, str]:
    env = os.environ.copy()
    env["PROFILE"] = str(profile_dir)
    env.update(apptainer_vars)
    if apptainer_vars.get("APPTAINER_SIF_DIR"):
        env[
            "APPTAINER_PREFIX_ARG"
        ] = f"--apptainer-prefix={apptainer_vars['APPTAINER_SIF_DIR']}"
    return env


def shell_run(
    cmd_list,
    env: Dict[str, str],
    module_load: str,
    conda_activate: str,
    path_prepend: str,
) -> None:
    cmd = " ".join(shlex.quote(str(c)) for c in cmd_list)
    parts = [p for p in [path_prepend, conda_activate, module_load] if p]
    if parts:
        cmd = " && ".join(parts + [cmd])
        subprocess.run(["bash", "-lc", cmd], check=True, env=env)
    else:
        subprocess.run(cmd_list, check=True, env=env)


def create_runinfo(workdir: pathlib.Path) -> None:
    runinfo = workdir / "runinfo.yaml"
    if runinfo.exists():
        stamp = dt.datetime.fromtimestamp(runinfo.stat().st_mtime).strftime(
            "%y%m%d%H%M%S"
        )
        stats_dir = workdir / "stats"
        stats_dir.mkdir(exist_ok=True)
        runinfo.rename(stats_dir / f"runinfo.{stamp}.yaml")

    user = getpass.getuser()
    full_name = ""
    try:
        import pwd

        full_name = pwd.getpwnam(user).pw_gecos.split(",")[0]
    except Exception:
        full_name = ""

    groups = " ".join(str(g) for g in os.getgroups())
    lines = [
        f"Pipeline Dir: {PIPELINE_HOME}",
        f"Git Commit/Tag: {get_git_commit_tag(PIPELINE_HOME)}",
        f"Login: {user}",
        f"Name: {full_name}",
        f"Groups: {groups}",
        f"Date/Time: {dt.datetime.now()}",
    ]
    runinfo.write_text("\n".join(lines) + "\n")


def cleanup_tempdir(workdir: pathlib.Path) -> None:
    config_path = workdir / "config.yaml"
    if not config_path.exists():
        return
    cfg = yaml.safe_load(config_path.read_text()) or {}
    tempdir = str(cfg.get("tempdir", "")).strip()
    if not tempdir:
        return
    temp_path = pathlib.Path(tempdir)
    try:
        uuid.UUID(temp_path.name)
    except ValueError:
        return
    if temp_path.is_dir() and str(temp_path) not in {"/", "//"}:
        shutil.rmtree(temp_path)


def is_workdir_locked(workdir: pathlib.Path) -> bool:
    lock_path = workdir / ".snakemake" / "lock"
    return lock_path.exists()


